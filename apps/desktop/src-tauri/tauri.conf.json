{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ECAD",
  "version": "0.1.0",
  "identifier": "dev.agchild.ecad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ECAD \u2014 Electrical design",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
